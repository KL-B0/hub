---
export interface Props {
  class?: string;
  href: string;
  isPrimary?: boolean;
  "aria-label"?: string;
  rel?: string;
}

const {
  class: className,
  href,
  "aria-label": ariaLabel,
  rel,
} = Astro.props;
---

<a
  class:list={[
    "w-full h-16 px-5 cursor-pointer touch-manipulation justify-start",
    "inline-flex items-center justify-center gap-3 shrink-0",
    "whitespace-nowrap rounded-2xl transition-all",
    "border border-border/60 bg-card/80 text-foregroundhover:bg-card/80 hover:border-border/70",
    "transition-all duration-200 hover:shadow-xl hover:-translate-y-0.5 active:scale-[0.98]",
    "disabled:pointer-events-none disabled:opacity-50",
    "[&_svg]:pointer-events-none [&_svg:not([class*='size-'])]:size-6 [&_svg]:shrink-0",
    "outline-none focus-visible:border-accent focus-visible:ring-accent/30 focus-visible:ring-[3px]",
    className,
  ]}
  href={href ?? undefined}
  target={href ? "_blank" : undefined}
  rel={rel ?? (href ? "noopener noreferrer" : undefined)}
  aria-label={ariaLabel}
>
  <slot />
</a>
