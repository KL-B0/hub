---
import { Image } from "astro:assets";

import photo from "@/assets/images/photo.jpg";
---

<section class="px-4 pt-12 pb-6 flex flex-col gap-4 items-center text-center">
  <Image
    src={photo}
    alt="Lorenzo Capalbo"
    priority
    width={200}
    height={200}
    densities={[1.5, 2]}
    quality="max"
    class="rounded-2xl shadow-2xl"
  />

  <div class="flex-1 self-stretch flex items-center flex-col gap-2">
    <h1 class="text-3xl font-bold tracking-tight">Lorenzo Capalbo</h1>
    <p class="opacity-75 text-lg font-semibold">Software & AI Engineer</p>
  </div>
</section>
